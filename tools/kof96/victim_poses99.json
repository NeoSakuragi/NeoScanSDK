{
 "_doc": "Portable victim-pose vocabulary for KOF99 throws (keys 'state.step' of KOF99 game states, Terry's animations). KOF99 re-uses state numbers with other meanings than KOF98 (432 is a launched pose here, a grabbed pose in KOF98), so the names were given by FRAME: Terry's pose frames keep their KOF96/98 frame numbers and names (f177 launched, f154 grabbed...), 16 new frames named by eye. Same postures and angle convention as victim_poses98.json. Coverage: every state any KOF99 throw list gives any of the 34 victims (91 states, 165 steps); 'multi_step' states have per-fighter lengths (names describe Terry's animation).",
 "postures": {
  "grabbed": "standing, held by the opponent",
  "bent_back": "standing, bent backwards by the hold",
  "hunched": "standing, doubled over / bent forward",
  "hit_reel": "standing, reeling from a hit",
  "launched": "airborne, knees up, just thrown or knocked up",
  "horizontal": "body level in the air",
  "falling": "diagonal on the way down, head lower than feet",
  "inverted": "upside down, head down",
  "inverted_diagonal": "upside down, tilted",
  "lying": "on the floor",
  "curled": "balled up, rolling or tumbling",
  "standing": "upright and free (idle, walk, taunt frames some lists end on)"
 },
