+#ifdef NEOSCAN_AERR
+// NeoScanSDK (tools/brawler/aerr_core.sh): per P2 bank the highest P ROM byte read through the $200000 window and the
+// reads at or past a threshold; every distinct write into $200000-$2FFFFF (the bank register) [addr << 8 | size, data, n]
+uint32_t neoscan_pmax[16], neoscan_pthr[16] = {0xfffff,0xfffff,0xfffff,0xfffff,0xfffff,0xfffff,0xfffff,0xfffff,0xfffff,0xfffff,0xfffff,0xfffff,0xfffff,0xfffff,0xfffff,0xfffff}, neoscan_phits[16], neoscan_plast[16];
+uint32_t neoscan_bwn, neoscan_bw_buf[256*3];
+static void neoscan_bw(uint32_t a, uint32_t d, uint32_t sz) { uint32_t k = a << 8 | sz; unsigned i; for (i = 0; i < neoscan_bwn; i++) if (neoscan_bw_buf[i*3] == k && neoscan_bw_buf[i*3+1] == d) { neoscan_bw_buf[i*3+2]++; return; } if (neoscan_bwn < 256) { neoscan_bw_buf[neoscan_bwn*3] = k; neoscan_bw_buf[neoscan_bwn*3+1] = d; neoscan_bw_buf[neoscan_bwn*3+2] = 1; neoscan_bwn++; } }
+#define NEOSCAN_PSTAT(addr) { uint32_t o = (addr & 0xfffff) + banksw_addr; unsigned b = (banksw_addr >> 20) & 15; if (o > neoscan_pmax[b]) neoscan_pmax[b] = o; if ((o & 0xfffff) >= neoscan_pthr[b]) { neoscan_phits[b]++; neoscan_plast[b] = o; } }
+#define NEOSCAN_BW(a, d, sz) neoscan_bw(a, d, sz);
+#else
+#define NEOSCAN_PSTAT(addr)
+#define NEOSCAN_BW(a, d, sz)
+#endif
