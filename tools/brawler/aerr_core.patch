diff -ruN a/libretro/libretro.c b/libretro/libretro.c
--- a/libretro/libretro.c	2026-10-10 01:58:04.000000000 +0200
+++ b/libretro/libretro.c	2026-10-16 21:42:47.139569744 +0200
@@ -1546,3 +1546,17 @@
     (void)enabled;
     (void)code;
 }
+
+#ifdef NEOSCAN_AERR
+/* NeoScanSDK address-error core (tools/brawler/aerr_core.sh, harness.py BRAWLER_AERR): odd-address word / long accesses
+   (count, ring of 4096 [addr, write mode, fc, ppc]); the mode (0 off, 1 log, 2 log + the 68000's exception) returns the
+   previous one (-1: unchanged); clear zeroes the log and the P2 / bank-write stats */
+extern int neoscan_aerr_mode; extern unsigned neoscan_aerr_n; extern unsigned neoscan_aerr_buf[];
+unsigned retro_neoscan_aerr(unsigned **buf) { *buf = neoscan_aerr_buf; return neoscan_aerr_n; }
+int retro_neoscan_aerr_mode(int mode) { int o = neoscan_aerr_mode; if (mode >= 0) neoscan_aerr_mode = mode; return o; }
+extern uint32_t neoscan_pmax[16], neoscan_pthr[16], neoscan_phits[16], neoscan_plast[16];
+uint32_t *retro_neoscan_pstat(int k) { return k == 0 ? neoscan_pmax : k == 1 ? neoscan_pthr : k == 2 ? neoscan_phits : neoscan_plast; }
+extern uint32_t neoscan_bwn, neoscan_bw_buf[];
+uint32_t retro_neoscan_bw(uint32_t **b) { *b = neoscan_bw_buf; return neoscan_bwn; }
+void retro_neoscan_aerr_clear(void) { unsigned i; neoscan_aerr_n = 0; neoscan_bwn = 0; for (i = 0; i < 16; i++) { neoscan_pmax[i] = 0; neoscan_phits[i] = 0; neoscan_plast[i] = 0; } }
+#endif
