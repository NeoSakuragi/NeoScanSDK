 /* ======================================================================== */
+
+#ifdef NEOSCAN_AERR
+/* NeoScanSDK: odd-address word / long accesses (m68kcpu.h m68ki_check_address_error): a count and the last 4096
+   as [address, write mode (16 read / 0 write), function code, PPC] */
+int neoscan_aerr_mode = 1;
+unsigned neoscan_aerr_n; unsigned neoscan_aerr_buf[4096 * 4];
+void neoscan_aerr_log(unsigned addr, unsigned wm, unsigned fc) {
+    unsigned i = neoscan_aerr_n++ & 4095;
+    neoscan_aerr_buf[i * 4] = addr; neoscan_aerr_buf[i * 4 + 1] = wm; neoscan_aerr_buf[i * 4 + 2] = fc; neoscan_aerr_buf[i * 4 + 3] = REG_PPC;
+}
+/* every exception the CPU takes through m68ki_jump_vector (bus / address error, illegal, zero divide, CHK, TRAPV,
+   privilege, trace, line A / F, format, TRAP #n; interrupts and the reset are not logged): a count and the last 256
+   as [vector, PPC, A7] */
+unsigned neoscan_exc_n; unsigned neoscan_exc_buf[256 * 3];
+void neoscan_exc_log(unsigned vector) {
+    unsigned i = neoscan_exc_n++ & 255;
+    neoscan_exc_buf[i * 3] = vector; neoscan_exc_buf[i * 3 + 1] = REG_PPC; neoscan_exc_buf[i * 3 + 2] = REG_A[7];
+}
+#endif
