+extern unsigned short *neoscan_prof_map;
+extern unsigned int neoscan_prof_fn[8192];
+unsigned int *retro_neoscan_prof(int which) { return which ? neoscan_prof_fn : neoscan_prof_pc; }
+void retro_neoscan_prof_map(unsigned short *map) { neoscan_prof_map = map; }
+extern unsigned short *neoscan_prof_entry;
+extern unsigned int neoscan_prof_incl[8192], neoscan_prof_tick_pc, neoscan_prof_ticks, neoscan_prof_snap[4][2][8192];
+void retro_neoscan_prof_setup(unsigned short *map, unsigned short *entry, unsigned tick_pc) {
+    neoscan_prof_map = map; neoscan_prof_entry = entry; neoscan_prof_tick_pc = tick_pc; }
+unsigned int *retro_neoscan_prof_incl(void) { return neoscan_prof_incl; }
+unsigned int retro_neoscan_prof_ticks(void) { return neoscan_prof_ticks; }
+unsigned int *retro_neoscan_prof_snap(void) { return &neoscan_prof_snap[0][0][0]; }
diff -ru a/src/m68k/m68kcpu.c b/src/m68k/m68kcpu.c
--- a/src/m68k/m68kcpu.c	2026-10-14 17:34:46.708068574 +0200
+++ b/src/m68k/m68kcpu.c	2026-10-14 17:34:46.714395379 +0200
@@ -1,3 +1,4 @@
+#include <string.h>
 /* ======================================================================== */
 /* ========================= LICENSING & COPYRIGHT ======================== */
 /* ======================================================================== */
@@ -937,6 +938,34 @@
 
 /* Execute some instructions until we use up num_cycles clock cycles */
 /* ASG: removed per-instruction interrupt checks */
+/* NeoScanSDK CPU profiler (scratch build only): cycles per instruction word address and per mapped function */
+unsigned int neoscan_prof_pc[0x100000];
+unsigned short *neoscan_prof_map;
+unsigned int neoscan_prof_fn[8192];
+/* inclusive: a shadow call stack (a function entry pushes (id, A7); A7 above an entry's pops it) */
+unsigned short *neoscan_prof_entry;            /* per word: function id + 1 at a function's first instruction, else 0 */
+unsigned int neoscan_prof_incl[8192];
+unsigned int neoscan_prof_tick_pc = 0xffffffff, neoscan_prof_ticks;
+unsigned int neoscan_prof_snap[4][2][8192];    /* excl / incl at each game_tick entry, ring of 4 ticks */
+static struct { unsigned short id; unsigned sp; } nsp_stk[64];
+static int nsp_depth;
+static unsigned nsp_attr;   /* cycles attributed to instructions in this m68k_execute */
+static void nsp_track(unsigned pc) {
+	unsigned sp = REG_A[7];
+	while (nsp_depth && sp > nsp_stk[nsp_depth - 1].sp) nsp_depth--;
+	if (pc == neoscan_prof_tick_pc) {
+		unsigned k = neoscan_prof_ticks & 3;
+		memcpy(neoscan_prof_snap[k][0], neoscan_prof_fn, sizeof neoscan_prof_fn);
+		memcpy(neoscan_prof_snap[k][1], neoscan_prof_incl, sizeof neoscan_prof_incl);
+		neoscan_prof_ticks++;
+	}
+	if (neoscan_prof_entry && pc < 0x200000) {
+		unsigned e = neoscan_prof_entry[pc >> 1];
+		if (e && !(nsp_depth && nsp_stk[nsp_depth - 1].id == e - 1 && nsp_stk[nsp_depth - 1].sp == sp) && nsp_depth < 64) {
+			nsp_stk[nsp_depth].id = e - 1; nsp_stk[nsp_depth].sp = sp; nsp_depth++;
+		}
+	}
+}
 int m68k_execute(int num_cycles)
 {
 	/* eat up any reset cycles */
@@ -948,6 +977,7 @@
 		return rc;
 	}
 
+	nsp_attr = 0;
 	/* Set our pool of clock cycles available */
 	SET_CYCLES(num_cycles);
 	m68ki_initial_cycles = num_cycles;
@@ -986,9 +1016,14 @@
 			}*/
 
 			/* Read an instruction and call its handler */
+			{ int c0 = m68ki_initial_cycles - GET_CYCLES(); unsigned pc = REG_PPC & 0xffffff; nsp_track(pc);
 			REG_IR = m68ki_read_imm_16();
 			m68ki_instruction_jump_table[REG_IR]();
 			USE_CYCLES(CYC_INSTRUCTION[REG_IR]);
+			{ unsigned d = (unsigned)(m68ki_initial_cycles - GET_CYCLES() - c0); nsp_attr += d;
+			  if (pc < 0x200000) { neoscan_prof_pc[pc >> 1] += d; neoscan_prof_fn[neoscan_prof_map ? neoscan_prof_map[pc >> 1] : 0] += d; }
+			  else neoscan_prof_fn[pc < 0x300000 ? 8190 : 8191] += d;
+			  { int k; for (k = 0; k < nsp_depth; k++) neoscan_prof_incl[nsp_stk[k].id] += d; } } }
 
 			/* Trace m68k_exception, if necessary */
 			m68ki_exception_if_trace(); /* auto-disable (see m68kcpu.h) */
@@ -1001,7 +1036,8 @@
 		SET_CYCLES(0);
 
 	/* return how many clocks we used */
-	return m68ki_initial_cycles - GET_CYCLES();
+	{ int used = m68ki_initial_cycles - GET_CYCLES();     /* the rest (interrupt entry, a stop): bucket 8189 */
+	  if (used > (int)nsp_attr) neoscan_prof_fn[8189] += used - nsp_attr; return used; }
 }
 
 
