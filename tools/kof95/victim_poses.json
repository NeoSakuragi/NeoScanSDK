{
 "_doc": "Portable victim-pose vocabulary for throws. Every pose a thrower puts the victim in is a KOF95 game state (+ the step reached in that state's animation, as the engine's raw record index); the victim's own state->slot table gives the frame, so the same numbers work for every KOF95 fighter. To reuse throws with sprites from another game, map each 'posture' (+ 'angle') to a frame of that game. posture: what the body does. angle: approximate body rotation in degrees, read by eye from Terry's frames: 0 = upright, 90 = horizontal with the head toward the side the victim faces, -90 = horizontal with the head toward its back, 180 = head down. Keys: 'state.step'. Coverage: every state any throw table gives any of the 26 victims (tools/kof95/throwtables.py).",
 "postures": {
  "grabbed": "standing, held by the opponent",
  "bent_back": "standing, bent backwards by the hold",
  "hunched": "standing, doubled over / bent forward",
  "hit_reel": "standing, reeling from a hit",
  "launched": "airborne, knees up, just thrown or knocked up",
  "horizontal": "body level in the air",
  "falling": "diagonal on the way down, head lower than feet",
  "inverted": "upside down, head down",
  "inverted_diagonal": "upside down, tilted",
  "lying": "on the floor"
 },
