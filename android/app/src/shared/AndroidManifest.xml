<?xml version="1.0" encoding="utf-8"?>
<!-- THE SHARED PLAYER (TODO T2): merged over src/main's manifest. No self-update (no install permissions, no
     PlayerUpdate receivers), HTTPS only (cleartext only in a -PshareBase=http://... proof build). What stays: INTERNET (sign-in, the build, the notes), RECORD_AUDIO (the Feedback
     button's voice note, asked at its first use), VIBRATE (the pad). -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android" xmlns:tools="http://schemas.android.com/tools">
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" tools:node="remove" />
    <uses-permission android:name="android.permission.UPDATE_PACKAGES_WITHOUT_USER_ACTION" tools:node="remove" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" tools:node="remove" />
    <application android:usesCleartextTraffic="${shareCleartext}" tools:replace="android:usesCleartextTraffic">
        <receiver android:name=".PlayerUpdate$Status" tools:node="remove" />
        <receiver android:name=".PlayerUpdate$Restart" tools:node="remove" />
    </application>
</manifest>
