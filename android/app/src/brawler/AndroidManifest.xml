<?xml version="1.0" encoding="utf-8"?>
<!-- THE BRAWLER APP (flavor "brawler", docs/feedback.md "Roles and the two apps"): merged over src/main's manifest. Since
     0.0.42 it updates itself as Brawler Dev does (src/main PlayerUpdate.kt: REQUEST_INSTALL_PACKAGES, the PackageInstaller
     session's Status receiver, Restart on MY_PACKAGE_REPLACED, POST_NOTIFICATIONS for "installed: tap to play"; all from
     src/main's manifest). HTTPS only (cleartext only in a -PorosBase / -PfeedbackBase=http://... proof build). -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android" xmlns:tools="http://schemas.android.com/tools">
    <!-- 0.0.37: the NEO·GEO icon (res/mipmap-*, tools/brawler/make_tester_icon.py); no settings page (Prefs: fixed) -->
    <application android:usesCleartextTraffic="${cleartext}" android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round" tools:replace="android:usesCleartextTraffic">
        <activity android:name=".SettingsActivity" tools:node="remove" />
        <!-- landscape only: the game (Prefs fixed) and My tickets, so the phone never turns between them -->
        <activity android:name=".MainActivity" android:screenOrientation="sensorLandscape" tools:replace="android:screenOrientation" />
        <activity android:name=".FeedbackListActivity" android:screenOrientation="sensorLandscape" />
    </application>
</manifest>
